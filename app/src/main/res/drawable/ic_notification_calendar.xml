<?xml version="1.0" encoding="utf-8"?>
<!--
  A wall calendar, for the 24dp status-bar slot.

  Not the launcher mark shrunk down. A status-bar glyph is one flat colour a few millimetres
  across, sitting in a row of a dozen other rounded squares, and its whole job is to be read as
  "calendar" at a glance — the two legs are what do that, and nothing else in the tray has them.
  The launcher icon can carry the grid because it has colour and size to spend; this cannot.

  Exactly two overlapping shapes, so evenOdd does one unambiguous thing: the body, hollowed out
  below the header band. The legs sit clear of both. A third overlapping shape here would XOR the
  band back into a hole.

  No android:tint. The system tints a notification's small icon itself and keeps only the alpha
  channel, so a tint is at best ignored and at worst resolved against the wrong theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillType="evenOdd"
      android:fillColor="#FFFFFFFF"
      android:pathData="
        M6.8,4.8 h10.4 a4.2,4.2 0 0 1 4.2,4.2 v8.2 a4.2,4.2 0 0 1 -4.2,4.2 h-10.4 a4.2,4.2 0 0 1 -4.2,-4.2 v-8.2 a4.2,4.2 0 0 1 4.2,-4.2 z
        M7.4,10.6 h9.2 a2,2 0 0 1 2,2 v4.2 a2,2 0 0 1 -2,2 h-9.2 a2,2 0 0 1 -2,-2 v-4.2 a2,2 0 0 1 2,-2 z
        M8.1,2.2 a1.3,1.3 0 0 1 1.3,1.3 v1.6 a1.3,1.3 0 0 1 -1.3,1.3 a1.3,1.3 0 0 1 -1.3,-1.3 v-1.6 a1.3,1.3 0 0 1 1.3,-1.3 z
        M15.7,2.2 a1.3,1.3 0 0 1 1.3,1.3 v1.6 a1.3,1.3 0 0 1 -1.3,1.3 a1.3,1.3 0 0 1 -1.3,-1.3 v-1.6 a1.3,1.3 0 0 1 1.3,-1.3 z"/>
</vector>
